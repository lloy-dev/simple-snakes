pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- simple snakes
-- by lloydev

is_debug = false

boundary_x0 = 1
boundary_y0 = 1
boundary_x1 = 126
boundary_y1 = 126

function _init()
  init_game()
  init_snake()
  respawn_food()
end

function _update()
  if not is_game_over then
    check_eat_food()
    move_snake()
    check_out_of_bounds()
    check_body_hit()
  else
    if btnp(5) then _init() end
  end
end

function _draw()
  cls()

  draw_boundary()
  draw_snake()
  draw_food()

  if is_game_over then
    display_game_over()
  else
    display_stats()
  end

  if is_debug then display_debug() end
end
-->8
-- utils

function init_game()
  score = 0
  is_game_over = false
end

function get_center_text(length)
  return 63 - ((length * 4) / 2)
end

function point_rect_collision(p, r)
  -- https://nerdyteachers.com/pico-8/collision/100
  return p.x >= r.x
      and p.x <= r.x + r.w
      and p.y >= r.y
      and p.y <= r.y + r.h
end

function draw_boundary()
  rect(boundary_x0, boundary_y0, boundary_x1, boundary_y1, 1)
end

function display_stats()
  print("score:" .. score, 7)
end

function display_game_over()
  local game_over_txt = "game over"
  local score_txt = "score:" .. score
  local play_again_txt = "press ❎ to play again"

  print(game_over_txt, get_center_text(#game_over_txt), 63 - 6, 8)
  print(score_txt, get_center_text(#score_txt), 63, 7)
  print(play_again_txt, get_center_text(#play_again_txt), 63 + 12, 3)
end

function display_debug()
  print("x:" .. snake.x, 1)
  print("y:" .. snake.y, 1)

  -- for body in all(snake.body) do
  --   print("x:" .. body.x .. ", y:" .. body.y)
  -- end

  print("food x:" .. food.x)
  print("food y:" .. food.y)
end
-->8
-- snake

function init_snake()
  snake = {}
  snake.x = 63
  snake.y = 63
  snake.is_eating = false

  --[[
        l - left
        r - right
        u - up
        d - down
    ]]
  snake.face = "l"

  snake.length = 6
  snake.body = {}

  for i = 1, snake.length do
    add_snake_body(snake.x + (snake.length - i), snake.y, i)
  end
end

function add_snake_body(x, y, index)
  snake.body[index] = {}
  snake.body[index].x = x
  snake.body[index].y = y
end

function move_snake()
  local snake_face_changed = false

  if btnp(0) and not (snake.face == "l" or snake.face == "r") then
    snake.face = "l"
    snake_face_changed = true
  elseif btnp(1) and not (snake.face == "r" or snake.face == "l") then
    snake.face = "r"
    snake_face_changed = true
  elseif btnp(2) and not (snake.face == "u" or snake.face == "d") then
    snake.face = "u"
    snake_face_changed = true
  elseif btnp(3) and not (snake.face == "d" or snake.face == "u") then
    snake.face = "d"
    snake_face_changed = true
  end

  if snake_face_changed then sfx(1) end

  local next_body = #snake.body + 1
  add_snake_body(snake.x, snake.y, next_body)
  if not snake.is_eating then
    deli(snake.body, 1)
  else
    snake.is_eating = false
  end

  if snake.face == "l" then
    snake.x -= 1
  elseif snake.face == "r" then
    snake.x += 1
  elseif snake.face == "u" then
    snake.y -= 1
  elseif snake.face == "d" then
    snake.y += 1
  end
end

function adjust_snake_spr(spr_vertical, spr_horizontal, x, y)
  local spr = spr_vertical
  local spr_x = x
  local spr_y = y
  local spr_flip = false

  if snake.face == "l" then
    spr = spr_vertical
    spr_y -= 1
    spr_flip = false
  elseif snake.face == "r" then
    spr = spr_vertical
    spr_x -= 3
    spr_y -= 2
    spr_flip = true
  elseif snake.face == "u" then
    spr = spr_horizontal
    spr_x -= 2
    spr_flip = false
  elseif snake.face == "d" then
    spr = spr_horizontal
    spr_x -= 1
    spr_y -= 3
    spr_flip = true
  end

  return {
    spr = spr,
    x = spr_x,
    y = spr_y,
    flip = spr_flip
  }
end

function get_snake_width_point()
  local x = snake.x
  local y = snake.y

  if snake.face == 'l' then
    y += 1
  elseif snake.face == 'r' then
    y -= 1
  elseif snake.face == 'u' then
    x -= 1
  elseif snake.face == 'd' then
    x += 1
  end

  return { x = x, y = y }
end

function draw_snake()
  -- body
  for i = 1, #snake.body do
    if i % 3 == 0 then
      local body = snake.body[i]
      local spr_body = adjust_snake_spr(3, 4, body.x, body.y)

      spr(spr_body.spr, spr_body.x, spr_body.y, 0.5, 0.5, spr_body.flip)
    end
  end

  local spr_head = adjust_snake_spr(1, 2, snake.x, snake.y)
  spr(spr_head.spr, spr_head.x, spr_head.y, 0.5, 0.5, spr_head.flip, spr_head.flip)

  if is_debug then
    for body in all(snake.body) do
      pset(body.x, body.y, 6)
    end

    pset(snake.x, snake.y, 6)
    local snake_p2 = get_snake_width_point()
    pset(snake_p2.x, snake_p2.y, 6)
  end
end

function check_out_of_bounds()
  if snake.x <= boundary_x0 or snake.y <= boundary_y0 or snake.x >= boundary_x1 or snake.y >= boundary_y1 then
    is_game_over = true
    sfx(2)
  end
end

function check_body_hit()
  for body in all(snake.body) do
    if snake.x == body.x and snake.y == body.y then
      is_game_over = true
      sfx(2)
    end
  end
end
-->8
-- food

function respawn_food()
  -- offset so food won't spawn on the score text
  local offset_x = 27
  local offset_y = 7
  local food_spr_width = 3

  food = {}
  food.x = flr(offset_x + rnd(boundary_x1 - food_spr_width - offset_x))
  food.y = flr(offset_y + rnd(boundary_y1 - food_spr_width - offset_y))
end

function draw_food()
  spr(5, food.x - 1, food.y - 1, 0.5, 0.5)

  if is_debug then
    pset(food.x, food.y, 3)
  end
end

function check_eat_food()
  local food_rect = { x = food.x, y = food.y, w = 2, h = 2 }
  local snake_p = { x = snake.x, y = snake.y }
  local snake_p2 = get_snake_width_point()

  if point_rect_collision(snake_p, food_rect) or point_rect_collision(snake_p2, food_rect) then
    sfx(0)
    snake.is_eating = true
    score += 1
    respawn_food()
  end
end
